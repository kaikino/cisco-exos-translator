# WARNINGS — review before deploying
# Input (problems in the Cisco config):
#   - Interface GigabitEthernet1/0/48: access VLAN 99 is referenced but not defined
#   - Interface GigabitEthernet2/0/1: routed interface (no switchport / ip address) is outside L2 conversion scope
#   - Interface TenGigabitEthernet1/1/1: trunk allowed VLAN 31 is referenced but not defined
#   - Interface TenGigabitEthernet1/1/1: trunk allowed VLAN 32 is referenced but not defined
# Translation (decisions made converting to EXOS):
#   - VLAN 31: referenced by a port but never defined; auto-creating it in the EXOS output
#   - VLAN 32: referenced by a port but never defined; auto-creating it in the EXOS output
#   - VLAN 99: referenced by a port but never defined; auto-creating it in the EXOS output
#   - TenGigabitEthernet1/1/1: unresolved uplink placeholder '1:{uplink-m1-p1}'; set uplinks.start in the mapping file (first uplink port number) or replace this port entry individually
#   - Stack member 1: Cisco model 'ws-c3850-48p' cannot be mapped to an EXOS slot type; configure the stack slot on the EXOS hardware
#   - Stack member 2: Cisco model 'ws-c3850-48p' cannot be mapped to an EXOS slot type; configure the stack slot on the EXOS hardware
#   - GigabitEthernet2/0/1: routed (L3) interface is out of L2 scope; skipped

# Translation reference (from the mapping file; edit it and re-run to change)
# VLANs (Cisco tag -> EXOS name):
#   10 -> USERS
#   20 -> VLAN_20  (auto-named)
#   30 -> VLAN_30  (auto-named)
#   31 -> VLAN_31  (auto-named)
#   32 -> VLAN_32  (auto-named)
#   40 -> GUEST
#   41 -> GUEST_41  (was 'GUEST')
#   42 -> GUEST_42  (was 'GUEST')
#   99 -> VLAN_99  (auto-named)
# Ports (Cisco name -> EXOS port):
#   GigabitEthernet1/0/1 -> 1:1
#   GigabitEthernet1/0/10 -> 1:10
#   GigabitEthernet1/0/11 -> 1:11
#   GigabitEthernet1/0/2 -> 1:2
#   GigabitEthernet1/0/3 -> 1:3
#   GigabitEthernet1/0/4 -> 1:4
#   GigabitEthernet1/0/48 -> 1:48
#   TenGigabitEthernet1/1/1 -> 1:{uplink-m1-p1}  (uplink placeholder; replace)
# LAG (Cisco Port-channel -> EXOS master port):
#   Port-channel1 -> 1:10  (members: 1:10, 1:11; lacp)

# System
configure snmp sysName "SW-STACK-01"

# Stacking (review: EXOS stacking is configured on-hardware)
#   slot 1: was 'ws-c3850-48p'
# configure stacking slot 1 priority 15
#   slot 2: was 'ws-c3850-48p'
# configure stacking slot 2 priority 10

# VLANs
create vlan "USERS" tag 10
create vlan "VLAN_20" tag 20
create vlan "VLAN_30" tag 30
create vlan "VLAN_31" tag 31
create vlan "VLAN_32" tag 32
create vlan "GUEST" tag 40
create vlan "GUEST_41" tag 41
create vlan "GUEST_42" tag 42
create vlan "VLAN_99" tag 99

# Link aggregation (sharing)
enable sharing 1:10 grouping 1:10,1:11 algorithm address-based L3_L4 lacp

# Port configuration
# Port-channel1
configure ports 1:10 description-string "Server LAG"
configure vlan Default delete ports 1:10
configure vlan "USERS" add ports 1:10 untagged
configure vlan "GUEST" add ports 1:10 tagged
configure vlan "GUEST_41" add ports 1:10 tagged
configure vlan "GUEST_42" add ports 1:10 tagged
configure ports 1:1 description-string "User port floor1"
configure vlan Default delete ports 1:1
configure vlan "USERS" add ports 1:1 untagged
configure vlan Default delete ports 1:2
configure vlan "USERS" add ports 1:2 untagged
disable ports 1:2
configure vlan Default delete ports 1:3
configure vlan "USERS" add ports 1:3 untagged
disable ports 1:3
configure vlan Default delete ports 1:4
configure vlan "USERS" add ports 1:4 untagged
disable ports 1:4
configure ports 1:48 description-string "Disabled port"
configure vlan Default delete ports 1:48
configure vlan "VLAN_99" add ports 1:48 untagged
disable ports 1:48
# GigabitEthernet2/0/1: routed interface skipped (L3, out of scope)
configure ports 1:{uplink-m1-p1} description-string "Uplink to core"
configure vlan Default delete ports 1:{uplink-m1-p1}
configure vlan "USERS" add ports 1:{uplink-m1-p1} untagged
configure vlan "VLAN_30" add ports 1:{uplink-m1-p1} tagged
configure vlan "VLAN_31" add ports 1:{uplink-m1-p1} tagged
configure vlan "VLAN_32" add ports 1:{uplink-m1-p1} tagged
configure vlan "GUEST" add ports 1:{uplink-m1-p1} tagged
