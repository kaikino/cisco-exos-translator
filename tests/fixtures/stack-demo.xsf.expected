# WARNINGS — review before deploying
# Not translated (17 line(s) outside this tool's L2 scope; review for anything you must port manually):
#   - 'spanning-tree portfast' x16 (lines 21, 27)
#   - 'end' (line 52)
# Translation (decisions made converting to EXOS):
#   - TenGigabitEthernet1/1/1: unresolved uplink placeholder '1:{uplink-m1-p1}'; set uplinks.start in the mapping file (first uplink port number) or replace this port entry individually
#   - Stack member 1: Cisco model 'ws-c3850-12s' cannot be mapped to an EXOS slot type; configure the stack slot on the EXOS hardware
#   - Stack member 2: Cisco model 'ws-c3850-12s' cannot be mapped to an EXOS slot type; configure the stack slot on the EXOS hardware

# Translation reference (from the mapping file; edit it and re-run to change)
# VLANs (Cisco tag -> EXOS name):
#   10 -> USERS
#   20 -> SERVERS
#   100 -> VOICE
# Ports (Cisco name -> EXOS port):
#   GigabitEthernet1/0/1 -> 1:1
#   GigabitEthernet1/0/10 -> 1:10
#   GigabitEthernet1/0/2 -> 1:2
#   GigabitEthernet1/0/3 -> 1:3
#   GigabitEthernet1/0/4 -> 1:4
#   GigabitEthernet1/0/5 -> 1:5
#   GigabitEthernet1/0/6 -> 1:6
#   GigabitEthernet1/0/7 -> 1:7
#   GigabitEthernet1/0/8 -> 1:8
#   GigabitEthernet2/0/1 -> 2:1
#   GigabitEthernet2/0/10 -> 2:10
#   GigabitEthernet2/0/12 -> 2:12
#   GigabitEthernet2/0/2 -> 2:2
#   GigabitEthernet2/0/3 -> 2:3
#   GigabitEthernet2/0/4 -> 2:4
#   GigabitEthernet2/0/5 -> 2:5
#   GigabitEthernet2/0/6 -> 2:6
#   GigabitEthernet2/0/7 -> 2:7
#   GigabitEthernet2/0/8 -> 2:8
#   TenGigabitEthernet1/1/1 -> 1:{uplink-m1-p1}  (uplink placeholder; replace)
# LAG (Cisco Port-channel -> EXOS master port):
#   Port-channel1 -> 1:10  (members: 1:10, 2:10; lacp)

# System
configure snmp sysName "SW-STACK-DEMO"

# Stacking (review: EXOS stacking is configured on-hardware)
#   slot 1: was 'ws-c3850-12s'
# configure stacking slot 1 priority 15
#   slot 2: was 'ws-c3850-12s'
# configure stacking slot 2 priority 10

# VLANs
create vlan "USERS" tag 10
create vlan "SERVERS" tag 20
create vlan "VOICE" tag 100

# Link aggregation (sharing)
enable sharing 1:10 grouping 1:10,2:10 algorithm address-based L3_L4 lacp

# Port configuration
# Port-channel1
configure ports 1:10 description-string "Cross-member server LAG"
configure vlan "USERS" add ports 1:10 tagged
configure vlan "SERVERS" add ports 1:10 tagged
configure vlan "VOICE" add ports 1:10 tagged
configure ports 1:1 description-string "Floor1 user port"
configure vlan Default delete ports 1:1
configure vlan "USERS" add ports 1:1 untagged
configure ports 1:2 description-string "Floor1 user port"
configure vlan Default delete ports 1:2
configure vlan "USERS" add ports 1:2 untagged
configure ports 1:3 description-string "Floor1 user port"
configure vlan Default delete ports 1:3
configure vlan "USERS" add ports 1:3 untagged
configure ports 1:4 description-string "Floor1 user port"
configure vlan Default delete ports 1:4
configure vlan "USERS" add ports 1:4 untagged
configure ports 1:5 description-string "Floor1 user port"
configure vlan Default delete ports 1:5
configure vlan "USERS" add ports 1:5 untagged
configure ports 1:6 description-string "Floor1 user port"
configure vlan Default delete ports 1:6
configure vlan "USERS" add ports 1:6 untagged
configure ports 1:7 description-string "Floor1 user port"
configure vlan Default delete ports 1:7
configure vlan "USERS" add ports 1:7 untagged
configure ports 1:8 description-string "Floor1 user port"
configure vlan Default delete ports 1:8
configure vlan "USERS" add ports 1:8 untagged
configure ports 2:1 description-string "Floor2 user port"
configure vlan Default delete ports 2:1
configure vlan "SERVERS" add ports 2:1 untagged
configure ports 2:12 description-string "UNUSED"
disable ports 2:12
configure ports 2:2 description-string "Floor2 user port"
configure vlan Default delete ports 2:2
configure vlan "SERVERS" add ports 2:2 untagged
configure ports 2:3 description-string "Floor2 user port"
configure vlan Default delete ports 2:3
configure vlan "SERVERS" add ports 2:3 untagged
configure ports 2:4 description-string "Floor2 user port"
configure vlan Default delete ports 2:4
configure vlan "SERVERS" add ports 2:4 untagged
configure ports 2:5 description-string "Floor2 user port"
configure vlan Default delete ports 2:5
configure vlan "SERVERS" add ports 2:5 untagged
configure ports 2:6 description-string "Floor2 user port"
configure vlan Default delete ports 2:6
configure vlan "SERVERS" add ports 2:6 untagged
configure ports 2:7 description-string "Floor2 user port"
configure vlan Default delete ports 2:7
configure vlan "SERVERS" add ports 2:7 untagged
configure ports 2:8 description-string "Floor2 user port"
configure vlan Default delete ports 2:8
configure vlan "SERVERS" add ports 2:8 untagged
configure ports 1:{uplink-m1-p1} description-string "Uplink to core"
configure vlan Default delete ports 1:{uplink-m1-p1}
configure vlan "USERS" add ports 1:{uplink-m1-p1} untagged
configure vlan "SERVERS" add ports 1:{uplink-m1-p1} tagged
configure vlan "VOICE" add ports 1:{uplink-m1-p1} tagged
